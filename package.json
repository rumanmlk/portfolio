{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Ruman Malik, AI engineer.",
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --project=chromium --project=mobile",
    "test:e2e:all": "playwright test -c playwright.all.config.ts --workers=1",
    "test:e2e:fresh": "pnpm build && pnpm test:e2e",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "resume:pdf": "node scripts/build-resume.mjs",
    "resume:preview": "node scripts/build-resume-preview.mjs",
    "stack:icons": "node scripts/build-stack-icons.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@vercel/analytics": "^2.0.1",
    "lenis": "^1.3.27",
    "motion": "^14.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "12.6.1",
    "pdfjs-dist": "4.10.38",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
